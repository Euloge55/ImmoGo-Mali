APP_NAME=ImmoGoMali
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Base de données MySQL ───────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=immogo-mali
DB_USERNAME=root
DB_PASSWORD=

# ─── Session ─────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Fichiers uploadés ───────────────────────────────────
FILESYSTEM_DISK=public

# ─── Cache / Queue ───────────────────────────────────────
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Mail ────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@immogomali.ml"
MAIL_FROM_NAME="${APP_NAME}"

# ─── CinetPay (configurable par agence dans l'interface) ─
# Les clés CinetPay se configurent par agence dans /admin/paiement/config
# Ces variables ne sont PAS utilisées — chaque agence a ses propres clés en base

VITE_APP_NAME="${APP_NAME}"
